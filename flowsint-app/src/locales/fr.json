    "vault": "Coffre-fort",
    "toggleTheme": "Basculer le thème",
    "themeLight": "Clair",
    "themeDark": "Sombre",
    "themeSystem": "Système",
    "info": {
      "title": "À propos de Flowsint",
      "p1": "<0>Flowsint</0> est une <1>plateforme d'enquête et de renseignement</1> conçue pour soutenir les flux de recherche complexes impliquant des <2>personnes, organisations, infrastructures et activités en ligne</2>.",
      "p2": "Que vous meniez des <0>cyber-enquêtes</0>, cartographiez des <1>réseaux de fraude</1> ou recueilliez des renseignements pour des <2>évaluations de menaces</2>, Flowsint vous aide à collecter, visualiser et comprendre des points de données fragmentés de manière structurée et interactive.",
      "whatItDoes": "Ce que fait Flowsint",
      "does1": "<0>Connecte des données dispersées</0> — e-mails, domaines, comptes sociaux, adresses IP, numéros de téléphone, adresses, etc. — en un seul <1>graphe d'enquête</1>.",
      "does2": "Propose des <0>modules visuels</0> pour passer d'une entité à d'autres : trouvez des <1>individus liés</1>, découvrez des <2>infrastructures</2>, dévoilez des <3>alias</3>.",
      "does3": "<0>Suit et sauvegarde les états de l'enquête</0> au fil du temps, vous permettant d'explorer plusieurs hypothèses ou de revenir sur d'anciennes pistes sans perdre le contexte.",
      "does4": "Prend en charge <0>l'enrichissement des données en direct</0> à partir de modules personnalisés ou intégrés, vous offrant des <1>informations exploitables</1> lors de votre exploration.",
      "whyUse": "Pourquoi utiliser Flowsint ?",
      "why1": "Conçu pour <0>la rapidité et la clarté</0> — rendu rapide des graphes, interface épurée, modules réactifs.",
      "why2": "<0>Modèle de graphe flexible</0> qui reflète la façon de penser des enquêteurs — pas seulement des tableaux et des étiquettes, mais des <1>relations</1>.",
      "why3": "Idéal pour les <0>analystes indépendants et les équipes</0> qui doivent agir vite, explorer librement et donner du sens à des <1>données partielles ou désordonnées</1>.",
      "useCases": "Cas d'utilisation",
      "case1": "Cartographie de l'<0>infrastructure numérique</0> de personnes ou d'organisations",
      "case2": "Enquête sur des <0>systèmes de fraude en ligne</0> ou de <1>fausses identités</1>",
      "case3": "Découverte de <0>liens entre acteurs</0> sur différentes plateformes",
      "case4": "Visualisation de la portée de <0>données divulguées ou exposées</0>",
      "case5": "Suivi du <0>comportement des acteurs malveillants</0> sur les surfaces sociales et techniques",
      "p3": "Flowsint est conçu pour les <0>professionnels</0> qui ont besoin d'un <1>contrôle total</1> sur leur logique d'enquête, de la structuration des données à l'interprétation des relations. Ce n'est pas juste un outil, c'est un <2>espace de travail flexible</2> pour construire du renseignement."
    }
  },
